# ============================================================
# SkyLogic MAS — Environment Variables
# Copy to .env and update values
# ============================================================

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=skylogic
POSTGRES_USER=skylogic_user
POSTGRES_PASSWORD=skylogic_secret
POSTGIS_PORT=5432

# --- Qdrant Vector Store ---
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# --- FastAPI ---
API_PORT=8000

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# --- Paths ---
DATA_DIR=./data
MODELS_DIR=./models

# --- PyTorch (CPU-Only for AMD Ryzen 5 4500U) ---
TORCH_DEVICE=cpu

# --- Training ---
BATCH_SIZE=2
NUM_WORKERS=2

# --- Trained model checkpoints (auto-detected if files exist) ---
YOLO_WEIGHTS=models/yolo/latest_best.pt
SEGFORMER_WEIGHTS=models/segformer/latest_best.pth
SAM_CHECKPOINT=models/sam/sam_vit_h_4b8939.pth

# --- Container behaviour ---
SKYLOGIC_AUTO_SEED=1
